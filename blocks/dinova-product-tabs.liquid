{%- comment -%}
  Dinova product tabs: up to three tabs (Description, Shipping & Return, ...)
  under the buy buttons. The first tab can show the product description.
  An optional Details tab (after tab 1) lists the product's metafields:
  gold karat and weight and the diamonds (count x carat per stone, total)
  from the selected variant, then material, stones, design, setting and closure.
{%- endcomment -%}

{%- liquid
  assign s = block.settings
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
  assign pmf = product.metafields.custom
  assign vmf = variant.metafields.custom
  assign groups = vmf.stone_groups.value
  assign tab_count = 0
-%}

{%- capture details -%}
  {%- if s.details_tab -%}
    {%- liquid
      assign total_ct = 0
      for g in groups
        assign group_ct = g.weight_ct | times: g.count
        assign total_ct = total_ct | plus: group_ct
      endfor
    -%}
    <dl class="dinova-ptabs__specs">
      {%- if vmf.gold_karat != blank or vmf.gold_weight != blank -%}
        <div class="dinova-ptabs__spec">
          <dt>Gold</dt>
          <dd>
            {%- if vmf.gold_karat != blank %}{{ vmf.gold_karat.value }}K{% endif -%}
            {%- if vmf.gold_karat != blank and vmf.gold_weight != blank %}, {% endif -%}
            {%- if vmf.gold_weight != blank %}{{ vmf.gold_weight.value }} g{% endif -%}
          </dd>
        </div>
      {%- endif -%}
      {%- if groups.size > 0 -%}
        <div class="dinova-ptabs__spec">
          <dt>Diamonds</dt>
          <dd>
            {%- for g in groups -%}
              <span class="dinova-ptabs__stone">{{ g.count }} &times; {{ g.weight_ct }} ct</span>
            {%- endfor -%}
            {%- if groups.size > 1 or groups[0].count > 1 -%}
              <span class="dinova-ptabs__stone">Total {{ total_ct | round: 2 }} ct</span>
            {%- endif -%}
          </dd>
        </div>
      {%- endif -%}
      {%- assign detail_keys = 'material,stones,design,setting,closure' | split: ',' -%}
      {%- for key in detail_keys -%}
        {%- if pmf[key] != blank -%}
          <div class="dinova-ptabs__spec">
            <dt>
              {%- case key -%}
                {%- when 'stones' -%}Stones
                {%- when 'closure' -%}Closure
                {%- else -%}{{ key | capitalize }}
              {%- endcase -%}
            </dt>
            <dd>{{ pmf[key] | metafield_tag }}</dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>
  {%- endif -%}
{%- endcapture -%}
{%- unless details contains '<dt>' -%}
  {%- assign details = '' -%}
{%- endunless -%}

{%- comment -%} Tab slots in display order: tab 1, Details, tab 2, tab 3. {%- endcomment -%}
{%- assign slots = '1,details,2,3' | split: ',' -%}

<dinova-product-tabs class="dinova-ptabs" {{ block.shopify_attributes }}>
  <div class="dinova-ptabs__list" role="tablist">
    {%- for i in slots -%}
      {%- liquid
        if i == 'details'
          assign label = s.details_label
          assign content = details
        else
          assign label_key = 'tab_' | append: i | append: '_label'
          assign content_key = 'tab_' | append: i | append: '_content'
          assign label = s[label_key]
          assign content = s[content_key]
          if i == '1' and s.tab_1_description and product.description != blank
            assign content = product.description
          endif
        endif
      -%}
      {%- if label != blank and content != blank -%}
        {%- assign tab_count = tab_count | plus: 1 -%}
        <button
          type="button"
          class="dinova-ptabs__tab"
          role="tab"
          id="DinovaTab-{{ block.id }}-{{ i }}"
          aria-controls="DinovaPanel-{{ block.id }}-{{ i }}"
          aria-selected="{% if tab_count == 1 %}true{% else %}false{% endif %}"
          tabindex="{% if tab_count == 1 %}0{% else %}-1{% endif %}"
        >
          {{- label | escape -}}
        </button>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- assign tab_count = 0 -%}
  {%- for i in slots -%}
    {%- liquid
      if i == 'details'
        assign label = s.details_label
        assign content = details
      else
        assign label_key = 'tab_' | append: i | append: '_label'
        assign content_key = 'tab_' | append: i | append: '_content'
        assign label = s[label_key]
        assign content = s[content_key]
        if i == '1' and s.tab_1_description and product.description != blank
          assign content = product.description
        endif
      endif
    -%}
    {%- if label != blank and content != blank -%}
      {%- assign tab_count = tab_count | plus: 1 -%}
      <div
        class="dinova-ptabs__panel rte"
        role="tabpanel"
        id="DinovaPanel-{{ block.id }}-{{ i }}"
        aria-labelledby="DinovaTab-{{ block.id }}-{{ i }}"
        tabindex="0"
        {% if tab_count > 1 %}
          hidden
        {% endif %}
      >
        {{ content }}
      </div>
    {%- endif -%}
  {%- endfor -%}
</dinova-product-tabs>

{% stylesheet %}
  .dinova-ptabs {
    display: block;
    width: 100%;
  }

  .dinova-ptabs__list {
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    border: 1px solid var(--dinova-ptabs-line, #d6d1c9);
  }

  .dinova-ptabs__tab {
    padding: 0.875rem 0.5rem;
    border: 0;
    border-inline-start: 1px solid var(--dinova-ptabs-line, #d6d1c9);
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.55;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .dinova-ptabs__tab:first-child {
    border-inline-start: 0;
  }

  .dinova-ptabs__tab:hover,
  .dinova-ptabs__tab[aria-selected='true'] {
    opacity: 1;
  }

  .dinova-ptabs__panel {
    padding: 1.5rem 1.75rem 1.75rem;
    border: 1px solid var(--dinova-ptabs-line, #d6d1c9);
    border-top: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .dinova-ptabs__panel > :first-child {
    margin-top: 0;
  }

  .dinova-ptabs__panel > :last-child {
    margin-bottom: 0;
  }

  .dinova-ptabs__specs {
    display: grid;
    gap: 0.875rem;
    margin: 0;
  }

  .dinova-ptabs__spec {
    display: grid;
    grid-template-columns: minmax(6.5rem, 30%) 1fr;
    gap: 1rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--dinova-ptabs-line, #d6d1c9);
  }

  .dinova-ptabs__spec:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .dinova-ptabs__spec dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .dinova-ptabs__spec dd {
    margin: 0;
  }

  .dinova-ptabs__stone {
    display: block;
  }
{% endstylesheet %}

<script type="module">
  if (!customElements.get('dinova-product-tabs')) {
    class DinovaProductTabs extends HTMLElement {
      connectedCallback() {
        this.tabs = [...this.querySelectorAll('[role="tab"]')];
        this.addEventListener('click', (event) => {
          const tab = event.target.closest('[role="tab"]');
          if (tab) this.select(tab);
        });
        this.addEventListener('keydown', (event) => {
          const index = this.tabs.indexOf(document.activeElement);
          if (index < 0) return;
          const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
          if (!step) return;
          event.preventDefault();
          const next = this.tabs[(index + step + this.tabs.length) % this.tabs.length];
          this.select(next);
          next.focus();
        });
      }

      select(active) {
        this.tabs.forEach((tab) => {
          const selected = tab === active;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          const panel = document.getElementById(tab.getAttribute('aria-controls'));
          if (panel) panel.hidden = !selected;
        });
      }
    }
    customElements.define('dinova-product-tabs', DinovaProductTabs);
  }
</script>

{% schema %}
{
  "name": "Dinova product tabs",
  "settings": [
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Tab 1 label",
      "default": "Description"
    },
    {
      "type": "checkbox",
      "id": "tab_1_description",
      "label": "Tab 1 shows the product description",
      "default": true
    },
    {
      "type": "richtext",
      "id": "tab_1_content",
      "label": "Tab 1 content",
      "info": "Used when the product description is off or empty."
    },
    {
      "type": "checkbox",
      "id": "details_tab",
      "label": "Show a Details tab after tab 1",
      "info": "Lists gold, diamonds (count x carat, total), material, stones, design, setting and closure from the product's metafields.",
      "default": true
    },
    {
      "type": "text",
      "id": "details_label",
      "label": "Details tab label",
      "default": "Details"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Tab 2 label",
      "default": "Shipping & Return"
    },
    {
      "type": "richtext",
      "id": "tab_2_content",
      "label": "Tab 2 content",
      "default": "<p>We deliver with contracted carriers across Egypt. Delivery times depend on your location, and the receipt of goods can be signed by a family member or doorman. Returns are accepted within 14 days in original condition.</p>"
    },
    {
      "type": "text",
      "id": "tab_3_label",
      "label": "Tab 3 label"
    },
    {
      "type": "richtext",
      "id": "tab_3_content",
      "label": "Tab 3 content"
    }
  ],
  "presets": [
    {
      "name": "Dinova product tabs"
    }
  ]
}
{% endschema %}
