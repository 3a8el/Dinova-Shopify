{%- comment -%}
  Dinova classic story: the opening of the old WordPress About page.
  A narrow text column on the left (title, serif subtitle, short text), a tall
  image beside it, then the long story paragraphs lower down on the right.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

<div
  class="dinova-classic-story{% if s.full_height %} dinova-classic-story--full{% endif %}"
  style="
    --dinova-cstory-bg: {{ s.background_color }};
    --dinova-cstory-text: {{ s.text_color }};
    --dinova-cstory-pt: {{ s.padding_top }}px;
    --dinova-cstory-pb: {{ s.padding_bottom }}px;
    --dinova-cstory-ratio: {{ s.image_ratio }};
  "
>
  <div class="dinova-classic-story__intro">
    {%- if s.title != blank -%}
      <h1 class="dinova-classic-story__title">{{ s.title | escape }}</h1>
    {%- endif -%}
    {%- if s.subtitle != blank -%}
      <h2 class="dinova-classic-story__subtitle">{{ s.subtitle | newline_to_br }}</h2>
    {%- endif -%}
    {%- if s.intro != blank -%}
      <div class="dinova-classic-story__intro-text">{{ s.intro }}</div>
    {%- endif -%}
  </div>

  <div class="dinova-classic-story__media">
    {%- if s.image != blank -%}
      {{
        s.image
        | image_url: width: 1400
        | image_tag:
          widths: '500, 700, 1000, 1400',
          sizes: '(min-width: 750px) 35vw, 80vw',
          loading: 'eager',
          class: 'dinova-classic-story__img'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'dinova-classic-story__img' }}
    {%- endif -%}
  </div>

  {%- if s.story != blank -%}
    <div class="dinova-classic-story__text">{{ s.story }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .dinova-classic-story {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding: var(--dinova-cstory-pt) 1.25rem var(--dinova-cstory-pb);
    background: var(--dinova-cstory-bg);
    color: var(--dinova-cstory-text);
  }

  .dinova-classic-story__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 400);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1.05;
    color: inherit;
  }

  .dinova-classic-story__subtitle {
    margin: 1.5rem 0 0;
    max-width: 30ch;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    text-wrap: balance;
    line-height: 1.2;
    color: inherit;
  }

  .dinova-classic-story__intro-text,
  .dinova-classic-story__text {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .dinova-classic-story__intro-text {
    max-width: 34ch;
    margin-top: 1.5rem;
  }

  .dinova-classic-story__intro-text p,
  .dinova-classic-story__text p {
    margin: 0 0 0.875em;
  }

  .dinova-classic-story__text p:last-child,
  .dinova-classic-story__intro-text p:last-child {
    margin-bottom: 0;
  }

  .dinova-classic-story__media {
    width: min(100%, 26rem);
    margin-inline: auto;
  }

  .dinova-classic-story__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--dinova-cstory-ratio);
    object-fit: cover;
  }

  @media screen and (min-width: 750px) {
    .dinova-classic-story {
      /* Text 0-32% (wide enough for a two-line subtitle), image 34-64%, story 64-100%. */
      grid-template-columns: 32% 2% 30% minmax(0, 1fr);
      gap: 0;
      padding-inline: 5%;
    }

    .dinova-classic-story__intro {
      grid-column: 1;
      grid-row: 1;
      align-self: start;
      padding: clamp(1rem, 3vw, 3rem) 1.5rem 0 0;
    }

    /* The image always starts at the very top of the section, ignoring the top spacing. */
    .dinova-classic-story__media {
      grid-column: 3;
      grid-row: 1;
      align-self: start;
      width: 100%;
      margin-top: calc(-1 * var(--dinova-cstory-pt));
    }

    .dinova-classic-story__text {
      grid-column: 4;
      grid-row: 1;
      align-self: end;
      max-width: 34rem;
      padding: 0 0 1.5rem 0.5rem;
    }
  }

  /* Desktop: fill the first screen so the next section starts below the fold. */
  @media screen and (min-width: 990px) {
    .dinova-classic-story--full {
      min-height: calc(100svh - var(--header-height, 0px));
      grid-template-rows: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dinova classic story",
  "tag": "section",
  "class": "dinova-classic-story-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Story"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Redefining the Diamond Industry, One Brilliant Choice at a Time"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Short text",
      "default": "<p>We didn’t set out to create another jewelry brand.</p><p>We set out to challenge an industry.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "5 / 7", "label": "Tall 5:7" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "2 / 3", "label": "Tall 2:3" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "auto", "label": "Original" }
      ],
      "default": "5 / 7"
    },
    {
      "type": "richtext",
      "id": "story",
      "label": "Story paragraphs (right)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Fill the screen on desktop",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    }
  ],
  "presets": [
    {
      "name": "Dinova classic story"
    }
  ]
}
{% endschema %}
