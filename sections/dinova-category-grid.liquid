{%- comment -%}
  Dinova category grid: large image tiles (two per row on desktop) for
  collections or tags. Each tile shows an image and a title; on hover a darker
  overlay fades in and a short sentence appears. On touch screens the tile
  crossing the middle of the screen gets the same effect, one tile at a time.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

<dinova-category-grid
  class="dinova-cgrid"
  style="
    --dinova-cgrid-bg: {{ s.background_color }};
    --dinova-cgrid-text: {{ s.text_color }};
    --dinova-cgrid-line: {{ s.line_color }};
    --dinova-cgrid-columns: {{ s.columns_desktop }};
    --dinova-cgrid-ratio: {{ s.tile_ratio }};
    --dinova-cgrid-ratio-mobile: {{ s.tile_ratio_mobile }};
    --dinova-cgrid-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};
    --dinova-cgrid-overlay-active: {{ s.overlay_active_opacity | divided_by: 100.0 }};
  "
>
  <ul class="dinova-cgrid__list" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign c = b.collection
        if block.type == 'tag'
          assign scope = c | default: collections.all
          assign tag_handle = b.tag | handleize
          assign url = scope.url | append: '/' | append: tag_handle
          if b.link != blank
            assign url = b.link
          endif
          assign title = b.title | default: b.tag
          assign img = b.image
          assign text = b.text
        else
          assign url = b.link | default: c.url | default: routes.all_products_collection_url
          assign title = b.title | default: c.title
          assign img = b.image | default: c.featured_image
          assign text = b.text | default: c.description | strip_html | truncatewords: 14
        endif
      -%}
      <li class="dinova-cgrid__item" {{ block.shopify_attributes }}>
        <a class="dinova-cgrid__tile" href="{{ url }}">
          {%- if img != blank -%}
            {{
              img
              | image_url: width: 1800
              | image_tag:
                widths: '600, 900, 1200, 1800',
                sizes: '(min-width: 750px) 50vw, 100vw',
                loading: 'lazy',
                alt: '',
                class: 'dinova-cgrid__image'
            }}
          {%- else -%}
            {{ 'collection-apparel-3' | placeholder_svg_tag: 'dinova-cgrid__image' }}
          {%- endif -%}
          <span class="dinova-cgrid__overlay" aria-hidden="true"></span>
          <span class="dinova-cgrid__content">
            <span class="dinova-cgrid__title">{{ title | escape }}</span>
            {%- if text != blank -%}
              <span class="dinova-cgrid__text">{{ text | escape }}</span>
            {%- endif -%}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</dinova-category-grid>

<script type="module">
  /* Touch screens: activate the tile crossing the middle of the screen, one at a time. */
  if (!customElements.get('dinova-category-grid')) {
    customElements.define(
      'dinova-category-grid',
      class DinovaCategoryGrid extends HTMLElement {
        connectedCallback() {
          this.touch = window.matchMedia('(hover: none)');
          this.tiles = [...this.querySelectorAll('.dinova-cgrid__tile')];
          this.observer = new IntersectionObserver((entries) => this.onIntersect(entries), {
            rootMargin: '-50% 0px -50% 0px',
          });
          this.tiles.forEach((tile) => this.observer.observe(tile));
        }

        disconnectedCallback() {
          this.observer?.disconnect();
        }

        onIntersect(entries) {
          if (!this.touch.matches) return;
          const hit = entries.find((entry) => entry.isIntersecting);
          if (!hit) return;
          this.tiles.forEach((tile) => tile.classList.toggle('is-active', tile === hit.target));
        }
      }
    );
  }
</script>

{% stylesheet %}
  .dinova-cgrid {
    display: block;
    padding: 1rem 1rem 1.25rem;
    border-top: 1px solid var(--dinova-cgrid-line);
    background: var(--dinova-cgrid-bg);
  }

  .dinova-cgrid__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .dinova-cgrid {
      padding: 1.25rem;
    }

    .dinova-cgrid__list {
      grid-template-columns: repeat(var(--dinova-cgrid-columns), minmax(0, 1fr));
      gap: 0.875rem;
    }
  }

  .dinova-cgrid__tile {
    position: relative;
    display: block;
    aspect-ratio: var(--dinova-cgrid-ratio-mobile);
    overflow: hidden;
    color: var(--dinova-cgrid-text);
    text-decoration: none;
  }

  @media screen and (min-width: 750px) {
    .dinova-cgrid__tile {
      aspect-ratio: var(--dinova-cgrid-ratio);
    }
  }

  .dinova-cgrid__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dinova-cgrid__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--dinova-cgrid-overlay);
    transition: opacity 0.6s ease;
  }

  .dinova-cgrid__content {
    position: absolute;
    left: clamp(1.25rem, 2.2vw, 2.25rem);
    right: clamp(1.25rem, 2.2vw, 2.25rem);
    bottom: clamp(1.25rem, 2.2vw, 2.25rem);
    display: grid;
  }

  .dinova-cgrid__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 2.4vw, 2.5rem);
    line-height: 1.1;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* The sentence is collapsed until the tile is hovered or active. */
  .dinova-cgrid__text {
    display: grid;
    max-width: 40ch;
    max-height: 0;
    overflow: hidden;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.5;
    opacity: 0;
    transform: translateY(0.75rem);
    transition: max-height 0.6s ease, opacity 0.5s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), margin 0.6s ease;
  }

  .dinova-cgrid__tile:is(:hover, :focus-visible, .is-active) .dinova-cgrid__overlay {
    opacity: var(--dinova-cgrid-overlay-active);
  }

  .dinova-cgrid__tile:is(:hover, :focus-visible, .is-active) .dinova-cgrid__text {
    max-height: 6em;
    margin-top: 0.625rem;
    opacity: 0.9;
    transform: none;
    transition-delay: 0s, 0.1s, 0.1s, 0s;
  }

  .dinova-cgrid__tile:is(:hover, :focus-visible, .is-active) .dinova-cgrid__image {
    transform: scale(1.04);
  }

  @media screen and (max-width: 749px) {
    .dinova-cgrid__title {
      font-size: 2rem;
    }

    .dinova-cgrid__text {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dinova-cgrid__image,
    .dinova-cgrid__overlay,
    .dinova-cgrid__title,
    .dinova-cgrid__text {
      transition: none;
    }

    .dinova-cgrid__tile:is(:hover, :focus-visible, .is-active) .dinova-cgrid__image {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dinova category grid",
  "tag": "section",
  "class": "dinova-cgrid-section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Tiles per row on desktop",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "tile_ratio",
      "label": "Tile shape on desktop",
      "options": [
        { "value": "3 / 2", "label": "Landscape" },
        { "value": "4 / 3", "label": "Classic" },
        { "value": "1 / 1", "label": "Square" }
      ],
      "default": "3 / 2"
    },
    {
      "type": "select",
      "id": "tile_ratio_mobile",
      "label": "Tile shape on mobile",
      "options": [
        { "value": "3 / 2", "label": "Landscape" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" }
      ],
      "default": "3 / 2"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay at rest",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 5
    },
    {
      "type": "range",
      "id": "overlay_active_opacity",
      "label": "Overlay on hover",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "paragraph",
      "content": "On phones the tile crossing the middle of the screen shows its hover effect, one tile at a time."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fffbf5"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Top line",
      "default": "#d6d1c9"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Defaults to the collection's name."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Sentence shown on hover",
          "info": "Defaults to the start of the collection's description."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Defaults to the collection's image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to the collection."
        }
      ]
    },
    {
      "type": "tag",
      "name": "Tag",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Product tag",
          "info": "Links to the products with this tag."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Within collection",
          "info": "Optional. Defaults to all products."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Defaults to the tag."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Sentence shown on hover"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Overrides the tag link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dinova category grid",
      "blocks": [
        { "type": "collection", "settings": { "title": "Bohemian Bliss", "text": "Our jewelry collection is handcrafted with the finest materials and attention to detail." } },
        { "type": "collection", "settings": { "title": "Celestial Symphony", "text": "Our jewelry collection is handcrafted with the finest materials and attention to detail." } },
        { "type": "collection", "settings": { "title": "Modern Minimalist", "text": "Our jewelry collection is handcrafted with the finest materials and attention to detail." } },
        { "type": "collection", "settings": { "title": "Moonlight Mischief", "text": "Our jewelry collection is handcrafted with the finest materials and attention to detail." } }
      ]
    }
  ]
}
{% endschema %}
