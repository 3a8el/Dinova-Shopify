{%- comment -%}
  Dinova journal hero: the blog's title, then a featured post with its title,
  excerpt and link on the left and its image on the right. If the post has a
  YouTube video (the section's link, or the post's custom.youtube_url
  metafield), a play button opens the video in place.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign article = s.article
  if article == blank and blog != blank
    assign article = blog.articles.first
  endif

  assign heading = s.heading | default: blog.title

  assign guest = article.metafields.custom.guest_name.value
  assign quote = article.metafields.custom.quote.value
  assign excerpt = article.excerpt | strip_html | strip
  if excerpt == blank
    assign excerpt = article.content | strip_html | truncatewords: s.excerpt_words
  endif

  assign thumb = s.image | default: article.image
  assign thumb_alt = article.title | default: ''

  assign video_id = blank
  if s.video.type == 'youtube'
    assign video_id = s.video.id
  else
    assign video_url = article.metafields.custom.youtube_url.value | default: article.metafields.custom.youtube_url
    if video_url != blank
      assign video_url = video_url | append: ''
      if video_url contains 'v='
        assign video_id = video_url | split: 'v=' | last | split: '&' | first
      else
        assign video_id = video_url | split: '?' | first | split: '/' | last
      endif
    endif
  endif
-%}

<dinova-journal-hero
  class="dinova-jhero dinova-jhero--image-{{ s.image_position }}"
  style="
    --dinova-jhero-bg: {{ s.background_color }};
    --dinova-jhero-text: {{ s.text_color }};
    --dinova-jhero-line: {{ s.line_color }};
    --dinova-jhero-ratio: {{ s.image_ratio }};
  "
>
  {%- if heading != blank -%}
    <h1 class="dinova-jhero__heading">{{ heading | escape }}</h1>
  {%- endif -%}

  <div class="dinova-jhero__feature">
    <div class="dinova-jhero__text-cell">
      <div class="dinova-jhero__text">
        {%- if article != blank -%}
          <h2 class="dinova-jhero__title">
            <a href="{{ article.url }}">{{ article.title | escape }}</a>
          </h2>
          {%- if quote != blank or guest != blank -%}
            <p class="dinova-jhero__guest">
              {%- if quote != blank %}<span class="dinova-jhero__quote">&ldquo;{{ quote | escape }}&rdquo;</span>{% endif -%}
              {%- if guest != blank %}<span>&mdash; {{ guest | escape }}</span>{% endif -%}
            </p>
          {%- endif -%}
          {%- if excerpt != blank -%}
            <p class="dinova-jhero__excerpt">{{ excerpt }}</p>
          {%- endif -%}
          {%- if s.link_label != blank -%}
            <a class="dinova-jhero__link dinova-underline" href="{{ article.url }}">
              {{- s.link_label | escape -}}
              <span class="visually-hidden">: {{ article.title | escape }}</span>
            </a>
          {%- endif -%}
        {%- else -%}
          <h2 class="dinova-jhero__title">Featured post title</h2>
          <p class="dinova-jhero__excerpt">Pick a blog post in this section's settings, or publish a post on this blog and the newest one shows here.</p>
        {%- endif -%}
      </div>
    </div>

    <div class="dinova-jhero__media-cell">
      <div class="dinova-jhero__media" {% if video_id != blank %}data-video-id="{{ video_id }}"{% endif %}>
        {%- if thumb != blank -%}
          {{
            thumb
            | image_url: width: 2000
            | image_tag:
              widths: '600, 900, 1300, 2000',
              sizes: '(min-width: 750px) 50vw, 100vw',
              fetchpriority: 'high',
              alt: thumb_alt,
              class: 'dinova-jhero__image'
          }}
        {%- elsif video_id != blank -%}
          <img
            class="dinova-jhero__image"
            src="https://i.ytimg.com/vi/{{ video_id }}/maxresdefault.jpg"
            alt="{{ article.title | escape }}"
            width="1280"
            height="720"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'dinova-jhero__image' }}
        {%- endif -%}

        {%- if video_id != blank -%}
          <button type="button" class="dinova-jhero__play" aria-label="Play video: {{ article.title | escape }}">
            <svg viewBox="0 0 80 80" aria-hidden="true" focusable="false">
              <circle cx="40" cy="40" r="38" fill="none" stroke="currentColor" stroke-width="2.5"/>
              <path d="M33 27l20 13-20 13z" fill="currentColor"/>
            </svg>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</dinova-journal-hero>

<script type="module">
  if (!customElements.get('dinova-journal-hero')) {
    customElements.define(
      'dinova-journal-hero',
      class DinovaJournalHero extends HTMLElement {
        connectedCallback() {
          const media = this.querySelector('[data-video-id]');
          const button = this.querySelector('.dinova-jhero__play');
          if (!media || !button) return;
          button.addEventListener('click', () => {
            const iframe = document.createElement('iframe');
            iframe.src = `https://www.youtube-nocookie.com/embed/${media.dataset.videoId}?autoplay=1&rel=0&playsinline=1`;
            iframe.title = button.getAttribute('aria-label');
            iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
            iframe.allowFullscreen = true;
            iframe.className = 'dinova-jhero__iframe';
            media.append(iframe);
            media.classList.add('is-playing');
            iframe.focus();
          });
        }
      }
    );
  }
</script>

{% stylesheet %}
  .dinova-jhero {
    display: block;
    background: var(--dinova-jhero-bg);
    color: var(--dinova-jhero-text);
  }

  .dinova-jhero__heading {
    margin: 0;
    padding: clamp(1.5rem, 3vw, 2.5rem) 1.25rem clamp(1.25rem, 2.5vw, 2rem);
    border-bottom: 1px solid var(--dinova-jhero-line);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 400);
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    line-height: 1;
    text-align: center;
    color: inherit;
  }

  .dinova-jhero__feature {
    display: grid;
    grid-template-columns: 1fr;
    border-bottom: 1px solid var(--dinova-jhero-line);
  }

  .dinova-jhero__media-cell {
    order: -1;
    padding: 1.25rem 1.25rem 0;
  }

  .dinova-jhero__media {
    position: relative;
    aspect-ratio: var(--dinova-jhero-ratio);
    overflow: hidden;
  }

  .dinova-jhero__media.is-playing {
    background: #000;
  }

  .dinova-jhero__image,
  .dinova-jhero__iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    border: 0;
    object-fit: cover;
    object-position: center;
  }

  .dinova-jhero__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .dinova-jhero__play svg {
    width: clamp(3.5rem, 6vw, 5.5rem);
    height: auto;
    filter: drop-shadow(0 2px 8px rgb(0 0 0 / 0.25));
    transition: transform 0.3s ease;
  }

  .dinova-jhero__play:hover svg,
  .dinova-jhero__play:focus-visible svg {
    transform: scale(1.08);
  }

  .dinova-jhero__media.is-playing .dinova-jhero__play,
  .dinova-jhero__media.is-playing .dinova-jhero__image {
    display: none;
  }

  .dinova-jhero__text-cell {
    display: flex;
    align-items: center;
    padding: 1.75rem 1.25rem 2.5rem;
  }

  .dinova-jhero__text {
    max-width: 26rem;
  }

  .dinova-jhero__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 400);
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    line-height: 1.1;
    color: inherit;
  }

  .dinova-jhero__title a {
    color: inherit;
    text-decoration: none;
  }

  .dinova-jhero__guest {
    display: grid;
    gap: 0.375rem;
    margin: 1rem 0 0;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .dinova-jhero__quote {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 1.375rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .dinova-jhero__excerpt {
    margin: 1.5rem 0 0;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 0.85;
  }

  .dinova-jhero__link {
    margin-top: 2rem;
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  @media screen and (min-width: 750px) {
    .dinova-jhero__feature {
      grid-template-columns: 1fr 1fr;
    }

    .dinova-jhero__media-cell {
      display: flex;
      flex-direction: column;
      order: 0;
      padding: 1.5rem;
      border-inline-start: 1px solid var(--dinova-jhero-line);
    }

    /* The image grows to the full column height when the text is taller. */
    .dinova-jhero__media {
      flex: 1 0 auto;
    }

    .dinova-jhero--image-left .dinova-jhero__media-cell {
      order: -1;
      border-inline-start: 0;
      border-inline-end: 1px solid var(--dinova-jhero-line);
    }

    .dinova-jhero__text-cell {
      justify-content: center;
      padding: 3rem clamp(2rem, 6vw, 6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dinova-jhero__play svg {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dinova journal hero",
  "tag": "section",
  "class": "dinova-jhero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Defaults to the blog's name."
    },
    {
      "type": "article",
      "id": "article",
      "label": "Featured post",
      "info": "Defaults to the newest post on this blog."
    },
    {
      "type": "video_url",
      "id": "video",
      "label": "YouTube link",
      "accept": ["youtube"],
      "info": "Optional. Otherwise uses the post's YouTube link (custom.youtube_url) when it has one."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. Defaults to the post's featured image."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read article"
    },
    {
      "type": "range",
      "id": "excerpt_words",
      "label": "Excerpt length",
      "info": "Used when the post has no excerpt.",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "w",
      "default": 55
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image on desktop",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "5 / 4", "label": "Landscape" },
        { "value": "16 / 9", "label": "Wide (video)" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" }
      ],
      "default": "5 / 4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fffbf5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Lines",
      "default": "#d6d1c9"
    }
  ],
  "presets": [
    {
      "name": "Dinova journal hero"
    }
  ]
}
{% endschema %}
