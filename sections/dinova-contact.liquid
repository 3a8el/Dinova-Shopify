{%- comment -%}
  Dinova contact: title, paragraph, contact details in a lined grid and a
  contact form on one side; a tall image with a small overlapping detail image
  on the other. Messages are sent through Shopify's contact form, so they
  arrive at the store's sender email (Settings > Notifications).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign form_id = 'DinovaContact-' | append: section.id
-%}

<div
  class="dinova-contact dinova-contact--media-{{ s.media_position }}"
  style="
    --dinova-contact-bg: {{ s.background_color }};
    --dinova-contact-text: {{ s.text_color }};
    --dinova-contact-line: {{ s.line_color }};
    --dinova-contact-offset: {{ s.sticky_offset }}px;
  "
>
  <div class="dinova-contact__content">
    <div class="dinova-contact__intro">
      {%- if s.title != blank -%}
        <h1 class="dinova-contact__title">{{ s.title | newline_to_br }}</h1>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="dinova-contact__text">{{ s.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <dl class="dinova-contact__details">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="dinova-contact__detail" {{ block.shopify_attributes }}>
            {%- if b.heading != blank -%}
              <dt class="dinova-contact__label">{{ b.heading | escape }}</dt>
            {%- endif -%}
            {%- if b.text != blank -%}
              <dd class="dinova-contact__value">{{ b.text | escape | newline_to_br }}</dd>
            {%- endif -%}
            {%- if b.email != blank -%}
              <dd class="dinova-contact__value">
                <a class="dinova-contact__link dinova-underline" href="mailto:{{ b.email | strip }}">{{ b.email | escape }}</a>
              </dd>
            {%- endif -%}
            {%- if b.phone != blank -%}
              {%- assign tel = b.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
              <dd class="dinova-contact__value">
                <a class="dinova-contact__link dinova-underline" href="tel:{{ tel }}">{{ b.phone | escape }}</a>
              </dd>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}

    <div class="dinova-contact__form-wrap">
      {%- if s.form_heading != blank -%}
        <h2 class="dinova-contact__form-heading">{{ s.form_heading | escape }}</h2>
      {%- endif -%}

      {%- form 'contact', id: form_id, class: 'dinova-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="dinova-contact__message" role="status" tabindex="-1" autofocus>{{ s.success_message | escape }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="dinova-contact__message dinova-contact__message--error" role="alert" tabindex="-1" autofocus>
              {%- for field in form.errors -%}
                <p>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                  {%- endif -%}
                </p>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="dinova-contact__fields">
            <div class="dinova-contact__field">
              <label for="{{ form_id }}-name">{{ s.name_label | escape }}</label>
              <input
                id="{{ form_id }}-name"
                type="text"
                name="contact[name]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                autocomplete="name"
                required
              >
            </div>
            <div class="dinova-contact__field">
              <label for="{{ form_id }}-email">{{ s.email_label | escape }}</label>
              <input
                id="{{ form_id }}-email"
                type="email"
                name="contact[email]"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                {% endif %}
              >
            </div>
            <div class="dinova-contact__field dinova-contact__field--full">
              <label for="{{ form_id }}-phone">{{ s.phone_label | escape }}</label>
              <input
                id="{{ form_id }}-phone"
                type="tel"
                name="contact[phone]"
                value="{{ form.phone }}"
                autocomplete="tel"
                pattern="[0-9\-\+\s\(\)]*"
              >
            </div>
            <div class="dinova-contact__field dinova-contact__field--full">
              <label for="{{ form_id }}-body">{{ s.message_label | escape }}</label>
              <textarea
                id="{{ form_id }}-body"
                name="contact[body]"
                rows="4"
                required
              >{{- form.body -}}</textarea>
            </div>
          </div>

          <button type="submit" class="dinova-contact__submit">{{ s.button_label | escape }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  <div class="dinova-contact__media">
    <div class="dinova-contact__main">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1800
          | image_tag:
            widths: '600, 900, 1200, 1800',
            sizes: '(min-width: 750px) 50vw, 100vw',
            loading: 'lazy',
            class: 'dinova-contact__image'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'dinova-contact__image' }}
      {%- endif -%}
    </div>
    {%- if s.show_detail_image -%}
      <div class="dinova-contact__detail-image{% if s.hide_detail_mobile %} dinova-contact__detail-image--hide-mobile{% endif %}">
        {%- if s.detail_image != blank -%}
          {{
            s.detail_image
            | image_url: width: 800
            | image_tag:
              widths: '300, 500, 800',
              sizes: '(min-width: 750px) 18vw, 40vw',
              loading: 'lazy',
              class: 'dinova-contact__image'
          }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'dinova-contact__image' }}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .dinova-contact {
    display: grid;
    gap: 2.5rem;
    padding: 2rem 1rem 3.5rem;
    background: var(--dinova-contact-bg);
    color: var(--dinova-contact-text);
  }

  .dinova-contact__content {
    display: grid;
    gap: 2.5rem;
    align-content: start;
  }

  .dinova-contact__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 400);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.02;
    color: inherit;
  }

  .dinova-contact__text {
    max-width: 34rem;
    margin-top: 1.25rem;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .dinova-contact__text p {
    margin: 0 0 0.75rem;
  }

  .dinova-contact__text p:last-child {
    margin-bottom: 0;
  }

  /* Contact details: a lined grid, two per row from tablet up. */
  .dinova-contact__details {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--dinova-contact-line);
  }

  .dinova-contact__detail {
    display: grid;
    gap: 0.375rem;
    align-content: start;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--dinova-contact-line);
  }

  .dinova-contact__label {
    margin: 0 0 0.375rem;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .dinova-contact__value {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .dinova-contact__link {
    color: inherit;
  }

  /* Form */
  .dinova-contact__form-heading {
    margin: 0 0 1.5rem;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 400);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.1;
    color: inherit;
  }

  .dinova-contact__fields {
    display: grid;
    gap: 1.75rem 2rem;
  }

  .dinova-contact__field {
    display: grid;
    gap: 0.25rem;
  }

  .dinova-contact__field label {
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .dinova-contact__field:focus-within label {
    opacity: 1;
  }

  .dinova-contact__field input,
  .dinova-contact__field textarea {
    width: 100%;
    padding: 0.625rem 0;
    border: 0;
    border-bottom: 1px solid var(--dinova-contact-line);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 1rem;
    outline: none;
    box-shadow: none;
    transition: border-color 0.3s ease;
  }

  .dinova-contact__field textarea {
    min-height: 7rem;
    resize: vertical;
  }

  .dinova-contact__field input:focus,
  .dinova-contact__field textarea:focus {
    border-bottom-color: currentColor;
  }

  .dinova-contact__field input[aria-invalid='true'] {
    border-bottom-color: #b3261e;
  }

  .dinova-contact__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 2rem;
    padding: 0.625rem 1.25rem;
    border: 1px solid currentColor;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .dinova-contact__submit:hover,
  .dinova-contact__submit:focus-visible {
    background: var(--dinova-contact-text);
    color: var(--dinova-contact-bg);
  }

  .dinova-contact__message {
    margin: 0 0 1.5rem;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
  }

  .dinova-contact__message p {
    margin: 0;
  }

  .dinova-contact__message--error {
    color: #b3261e;
    font-size: 0.8125rem;
  }

  /* Media: a tall image with a small detail image overlapping its corner. */
  .dinova-contact__media {
    position: relative;
    padding-bottom: 2.5rem;
  }

  .dinova-contact__main {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .dinova-contact__detail-image {
    position: absolute;
    left: -0.5rem;
    bottom: 0;
    width: 38%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 0.375rem solid var(--dinova-contact-bg);
  }

  .dinova-contact__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .dinova-contact__detail-image--hide-mobile {
      display: none;
    }

    .dinova-contact__media:has(.dinova-contact__detail-image--hide-mobile) {
      padding-bottom: 0;
    }
  }

  @media screen and (min-width: 750px) {
    .dinova-contact__details {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 2rem;
    }

    .dinova-contact__fields {
      grid-template-columns: repeat(2, 1fr);
    }

    .dinova-contact__field--full {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 990px) {
    .dinova-contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
      padding: clamp(3rem, 5vw, 4.5rem) clamp(1.75rem, 4vw, 4rem) clamp(4rem, 7vw, 6rem);
    }

    .dinova-contact--media-left .dinova-contact__media {
      order: -1;
    }

    .dinova-contact__content {
      gap: 3rem;
    }

    /* The images stay in view while the details and form scroll past. */
    .dinova-contact__media {
      position: sticky;
      top: calc(var(--header-height, 0px) + var(--dinova-contact-offset));
      padding-bottom: 0;
    }

    .dinova-contact__main {
      aspect-ratio: auto;
      height: calc(100vh - var(--header-height, 0px) - var(--dinova-contact-offset) * 2);
      min-height: 32rem;
    }

    .dinova-contact__detail-image {
      left: -2rem;
      bottom: 3rem;
      width: 34%;
      max-width: 15rem;
      border-width: 0.5rem;
    }

    .dinova-contact--media-left .dinova-contact__detail-image {
      left: auto;
      right: -2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dinova-contact__submit,
    .dinova-contact__field label,
    .dinova-contact__field input,
    .dinova-contact__field textarea {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dinova contact",
  "tag": "section",
  "class": "dinova-contact-section",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Get in touch"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Paragraph",
      "default": "<p>Whether you are choosing an engagement ring, designing a bespoke piece or simply have a question, our team is here to help. Send us a message and we will get back to you shortly.</p>"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
      "type": "checkbox",
      "id": "show_detail_image",
      "label": "Show small detail image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "detail_image",
      "label": "Detail image",
      "visible_if": "{{ section.settings.show_detail_image }}"
    },
    {
      "type": "checkbox",
      "id": "hide_detail_mobile",
      "label": "Hide detail image on mobile",
      "default": false,
      "visible_if": "{{ section.settings.show_detail_image }}"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Images on desktop",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "sticky_offset",
      "label": "Space above images on desktop",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Send an inquiry"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Phone number"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "Your inquiry"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Thank-you message",
      "default": "Thank you for reaching out. We will get back to you shortly."
    },
    {
      "type": "paragraph",
      "content": "Messages are emailed to the store's sender email, set in Settings > Notifications."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fffbf5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Lines",
      "default": "#d6d1c9"
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Contact detail",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "General Inquiries"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dinova contact",
      "blocks": [
        {
          "type": "detail",
          "settings": {
            "heading": "General Inquiries",
            "email": "info@dinovadiamond.com",
            "phone": "01200126408"
          }
        },
        {
          "type": "detail",
          "settings": {
            "heading": "Address",
            "text": "Launching Soon in Laketown, New Cairo, Egypt."
          }
        },
        {
          "type": "detail",
          "settings": {
            "heading": "Trusted Retail Partners",
            "text": "Across Cairo"
          }
        },
        {
          "type": "detail",
          "settings": {
            "heading": "Address",
            "text": "Obour City, New Egypt Gold."
          }
        }
      ]
    }
  ]
}
{% endschema %}
