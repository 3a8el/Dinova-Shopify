{%- doc -%}
  Dinova desktop navigation, rendered inside Horizon's menu drawer when the header's
  "Use menu button on desktop" setting is on. From 990px it replaces the stock drawer
  content: a panel opens under the header, the page behind it blurs, and a top-level
  item with children expands the panel to show its links in columns next to a
  carousel of images that scrolls from bottom to top.

  @param {object} linklist - The main menu
  @param {object} section - The header section (holds the Dinova drawer settings)
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign item_index = 0

  assign picked_images = ''
  for i in (1..6)
    assign key = 'dinova_nav_image_' | append: i
    if s[key] != blank
      assign picked_images = picked_images | append: i | append: ','
    endif
  endfor
  assign picked_images = picked_images | split: ','
-%}

{%- capture menu_slides -%}
  {%- for link in linklist.links -%}
    {%- render 'dinova-nav-slides', links: link.links -%}
  {%- endfor -%}
{%- endcapture -%}

<dinova-nav
  class="dinova-nav"
  style="--dinova-nav-columns: {{ s.dinova_nav_columns | default: 2 }};"
>
  <div class="dinova-nav__main">
    <ul class="dinova-nav__list" role="list">
      {%- for link in linklist.links -%}
        {%- assign item_index = item_index | plus: 1 -%}
        <li class="dinova-nav__item dinova-nav__fade" style="--i: {{ item_index }};">
          {%- if link.links.size > 0 -%}
            <button
              type="button"
              class="dinova-nav__link"
              aria-expanded="false"
              aria-controls="DinovaNavPanel-{{ link.handle }}"
              data-dinova-nav-toggle
            >
              <span class="dinova-nav__link-text">{{ link.title | escape }}</span>
              <span class="dinova-nav__caret" aria-hidden="true">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>
          {%- else -%}
            <a
              href="{{ link.url }}"
              class="dinova-nav__link"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              <span class="dinova-nav__link-text">{{ link.title | escape }}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    <div class="dinova-nav__footer">
      {%- if s.dinova_nav_secondary_menu.links.size > 0 -%}
        <ul class="dinova-nav__secondary" role="list">
          {%- for link in s.dinova_nav_secondary_menu.links -%}
            {%- assign item_index = item_index | plus: 1 -%}
            <li class="dinova-nav__fade" style="--i: {{ item_index }};">
              <a href="{{ link.url }}" class="dinova-nav__small-link dinova-underline">{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.dinova_nav_phone != blank -%}
        {%- assign item_index = item_index | plus: 1 -%}
        {%- assign phone_digits = s.dinova_nav_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
        <a href="tel:{{ phone_digits }}" class="dinova-nav__contact dinova-nav__fade" style="--i: {{ item_index }};">
          {{- s.dinova_nav_phone | escape -}}
        </a>
      {%- endif -%}

      {%- if s.dinova_nav_hours != blank -%}
        {%- assign item_index = item_index | plus: 1 -%}
        <p class="dinova-nav__contact dinova-nav__fade" style="--i: {{ item_index }};">{{ s.dinova_nav_hours | escape }}</p>
      {%- endif -%}

      {%- assign platforms = 'facebook,instagram,tiktok,pinterest' | split: ',' -%}
      {%- capture social -%}
        {%- for platform in platforms -%}
          {%- assign key = 'dinova_nav_' | append: platform | append: '_url' -%}
          {%- if s[key] != blank -%}
            <li>
              <a href="{{ s[key] }}" class="dinova-nav__social-link" target="_blank" rel="noopener">
                <span class="visually-hidden">{{ platform | capitalize }}</span>
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                  {%- render 'icon', icon: platform -%}
                </svg>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if social != blank -%}
        {%- assign item_index = item_index | plus: 1 -%}
        <ul class="dinova-nav__social dinova-nav__fade" style="--i: {{ item_index }};" role="list">
          {{- social -}}
        </ul>
      {%- endif -%}
    </div>
  </div>

  {%- for link in linklist.links -%}
    {%- if link.links.size > 0 -%}
      <div
        class="dinova-nav__panel"
        id="DinovaNavPanel-{{ link.handle }}"
        data-dinova-nav-panel
      >
        <div class="dinova-nav__groups">
          {%- for child in link.links -%}
            <div class="dinova-nav__group dinova-nav__fade" style="--i: {{ forloop.index }};">
              <a href="{{ child.url }}" class="dinova-nav__group-title"{% if child.current %} aria-current="page"{% endif %}>
                {{- child.title | escape -}}
              </a>
              {%- if child.links.size > 0 -%}
                <ul class="dinova-nav__group-list" role="list">
                  {%- for grandchild in child.links -%}
                    <li>
                      <a href="{{ grandchild.url }}" class="dinova-nav__small-link dinova-underline"{% if grandchild.current %} aria-current="page"{% endif %}>
                        {{- grandchild.title | escape -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%}
    One carousel shared by every submenu, so it keeps playing when another item is
    picked. Images picked in the header settings; without any, the images of the
    collections and products in the menu.
  {%- endcomment -%}
  {%- capture slides -%}
    {%- if picked_images.size > 0 -%}
      {%- for i in picked_images -%}
        {%- assign key = 'dinova_nav_image_' | append: i -%}
        <li class="dinova-nav__slide">
          {{ s[key] | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '24vw', loading: 'lazy', class: 'dinova-nav__image' }}
        </li>
      {%- endfor -%}
    {%- else -%}
      {{- menu_slides -}}
    {%- endif -%}
  {%- endcapture -%}

  {%- if slides != blank -%}
    <div class="dinova-nav__media" aria-hidden="true">
      {%- comment -%} Two copies, so the loop wraps without a gap {%- endcomment -%}
      <ul class="dinova-nav__track" role="list" style="--dinova-nav-speed: {{ s.dinova_nav_image_speed | default: 30 }}s;">
        {{- slides -}}
        {{- slides -}}
      </ul>
    </div>
  {%- endif -%}
</dinova-nav>

<script src="{{ 'dinova-nav.js' | asset_url }}" defer></script>

{% stylesheet %}
  .dinova-nav {
    display: none;
  }

  @media screen and (min-width: 990px) {
    /* ---------- The drawer: opens under the header ---------- */

    .menu-drawer:has(> .dinova-nav) {
      --dinova-nav-ease: cubic-bezier(0.22, 1, 0.36, 1);

      top: var(--dinova-nav-top, var(--header-height, 0px));
      height: calc(100dvh - var(--dinova-nav-top, var(--header-height, 0px)));
      width: var(--dinova-nav-main-width, 28rem);
      max-width: 100vw;
      padding: 0;
      overflow: hidden;
      border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
      border-inline-end: 0;
      transition: transform 0.6s var(--dinova-nav-ease), visibility 0.6s var(--dinova-nav-ease),
        width 0.6s var(--dinova-nav-ease);
    }

    .menu-drawer:has(> .dinova-nav) > :not(.dinova-nav) {
      display: none;
    }

    .menu-drawer:has(> .dinova-nav[data-expanded]) {
      width: 100vw;
    }

    .menu-drawer-container:has(.dinova-nav) .menu-drawer__backdrop {
      top: var(--dinova-nav-top, var(--header-height, 0px));
      height: auto;
      bottom: 0;
      background: rgb(var(--color-background-rgb) / 0.1);
      backdrop-filter: blur(0);
      -webkit-backdrop-filter: blur(0);
      transition: opacity 0.3s ease, backdrop-filter 0.3s ease, -webkit-backdrop-filter 0.3s ease;
    }

    /* The blur builds up slowly as the drawer finishes sliding in */
    .menu-open.menu-drawer-container:has(.dinova-nav) .menu-drawer__backdrop {
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition: opacity 0.4s ease 0.3s, backdrop-filter 0.9s ease 0.35s, -webkit-backdrop-filter 0.9s ease 0.35s;
    }

    /* ---------- Header: the Menu button becomes a close icon ---------- */

    #header-component[data-force-drawer] .menu-drawer-container.menu-open .dinova-menu-trigger {
      display: none;
    }

    #header-component[data-force-drawer] .menu-drawer-container.menu-open .header__icon--menu .header-drawer-icon--close {
      display: flex;
    }

    /* ---------- Layout ---------- */

    .dinova-nav {
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr) minmax(0, 24rem);
      flex: 1;
      min-height: 0;
      color: var(--color-foreground);
    }

    /* Sized by its longest item, so menu names stay on one line */
    .dinova-nav__main {
      min-width: 28rem;
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
      min-height: 0;
      padding: 2.5rem 3rem 2.5rem 4.5rem;
      overflow-y: auto;
    }

    /* ---------- Top-level items ---------- */

    .dinova-nav__list {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .dinova-nav__link {
      display: inline-flex;
      align-items: center;
      gap: 1.25rem;
      padding: 0.6rem 0;
      border: 0;
      background: none;
      color: inherit;
      font-family: var(--font-heading--family);
      font-weight: 400;
      font-size: clamp(2.5rem, 3.4vw, 3.5rem);
      line-height: 1.25;
      text-align: start;
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
      transition: opacity 0.3s ease;
    }

    .dinova-nav__link-text {
      background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 0 1px;
      transition: background-size 0.4s var(--dinova-nav-ease);
    }

    .dinova-nav__link:hover .dinova-nav__link-text,
    .dinova-nav__link[aria-expanded='true'] .dinova-nav__link-text {
      background-size: 100% 1px;
    }

    /* While a submenu is open, the other items step back */
    .dinova-nav[data-expanded] .dinova-nav__link:not([aria-expanded='true']) {
      opacity: 0.45;
    }

    .dinova-nav[data-expanded] .dinova-nav__link:not([aria-expanded='true']):hover {
      opacity: 1;
    }

    .dinova-nav__caret {
      display: inline-flex;
      width: 0.75rem;
      transform: rotate(-90deg);
      transition: transform 0.3s ease;
    }

    .dinova-nav__caret svg {
      width: 100%;
      height: auto;
    }

    .dinova-nav__link:hover .dinova-nav__caret {
      transform: rotate(-90deg) translateY(0.25rem);
    }

    /* ---------- Footer: small links, contact and social ---------- */

    .dinova-nav__footer {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-block-start: auto;
    }

    .dinova-nav__secondary {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .dinova-nav__small-link {
      color: inherit;
      font-family: var(--font-body--family);
      font-size: 0.875rem;
      line-height: 1.5;
      text-decoration: none;
    }

    .dinova-nav__contact {
      margin: 0;
      color: rgb(var(--color-foreground-rgb) / 0.7);
      font-family: var(--font-body--family);
      font-size: 1rem;
      text-decoration: none;
    }

    .dinova-nav__social {
      display: flex;
      gap: 0.75rem;
      margin: 0.25rem 0 0;
      padding: 0;
      list-style: none;
    }

    .dinova-nav__social-link {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
      color: inherit;
      transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    }

    .dinova-nav__social-link svg {
      width: 1rem;
      height: 1rem;
      fill: currentColor;
    }

    .dinova-nav__social-link:hover {
      border-color: var(--color-foreground);
      background: var(--color-foreground);
      color: var(--color-background);
    }

    /* ---------- Submenu panel ---------- */

    .dinova-nav__panel {
      display: none;
      grid-area: 1 / 2;
      min-height: 0;
    }

    .dinova-nav__panel.is-active {
      display: grid;
    }

    .dinova-nav:not(:has(.dinova-nav__media)) .dinova-nav__panel {
      grid-column: 2 / -1;
    }

    .dinova-nav__groups {
      display: grid;
      grid-template-columns: repeat(var(--dinova-nav-columns), minmax(0, 1fr));
      align-content: start;
      gap: 3rem 2.5rem;
      padding: 2.75rem 2.5rem;
      overflow-y: auto;
    }

    .dinova-nav__group-title {
      display: inline-block;
      color: inherit;
      font-family: var(--font-heading--family);
      font-size: 1.875rem;
      line-height: 1.2;
      text-decoration: none;
    }

    .dinova-nav__group-list {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
      margin: 1.25rem 0 0;
      padding: 0;
      list-style: none;
    }

    /* ---------- Image carousel: plays from bottom to top ---------- */

    /* Hidden with opacity rather than display, so the loop never restarts */
    .dinova-nav__media {
      grid-area: 1 / 3;
      position: relative;
      overflow: hidden;
      padding-inline-end: 2.5rem;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s;
    }

    .dinova-nav[data-expanded] .dinova-nav__media {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.8s ease 0.2s, visibility 0s;
    }

    .dinova-nav__track {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin: 0;
      padding: 0;
      list-style: none;
      animation: dinova-nav-rise var(--dinova-nav-speed) linear infinite;
    }

    .dinova-nav__media:hover .dinova-nav__track {
      animation-play-state: paused;
    }

    .dinova-nav__image {
      display: block;
      width: 100%;
      height: auto;
    }

    /* ---------- Entrance: items fade in from top to bottom ---------- */

    .menu-open .dinova-nav__main .dinova-nav__fade {
      animation: dinova-nav-fade 0.6s var(--dinova-nav-ease) both;
      animation-delay: calc(0.3s + var(--i) * 0.05s);
    }

    .dinova-nav__panel.is-active .dinova-nav__fade {
      animation: dinova-nav-fade 0.6s var(--dinova-nav-ease) both;
      animation-delay: calc(0.15s + var(--i) * 0.05s);
    }
  }

  @keyframes dinova-nav-fade {
    from {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes dinova-nav-rise {
    to {
      transform: translateY(calc(-50% - 0.375rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dinova-nav__track,
    .dinova-nav__fade {
      animation: none !important;
    }
  }
{% endstylesheet %}
