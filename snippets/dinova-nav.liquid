{%- doc -%}
  Dinova navigation, rendered inside Horizon's menu drawer when the header's
  "Use menu button on desktop" setting is on. It replaces the stock drawer content
  at every width, and the drawer opens under the header.

  From 990px the page behind blurs, and a top-level item with children expands the
  drawer to show its links in columns next to a carousel of images that scrolls
  from bottom to top. Below 990px an item with children opens its links on a page
  that slides in from the right, with a back button; a third level works the same.

  @param {object} linklist - The main menu
  @param {object} section - The header section (holds the Dinova drawer settings)
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign item_index = 0

  assign picked_images = ''
  for i in (1..6)
    assign key = 'dinova_nav_image_' | append: i
    if s[key] != blank
      assign picked_images = picked_images | append: i | append: ','
    endif
  endfor
  assign picked_images = picked_images | split: ','
-%}

{%- capture menu_slides -%}
  {%- for link in linklist.links -%}
    {%- render 'dinova-nav-slides', links: link.links -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture caret -%}
  <span class="dinova-nav__caret" aria-hidden="true">
    {{- 'icon-caret.svg' | inline_asset_content -}}
  </span>
{%- endcapture -%}

<dinova-nav
  class="dinova-nav"
  style="--dinova-nav-columns: {{ s.dinova_nav_columns | default: 2 }};"
>
  <div class="dinova-nav__main">
    <ul class="dinova-nav__list" role="list">
      {%- for link in linklist.links -%}
        {%- assign item_index = item_index | plus: 1 -%}
        <li class="dinova-nav__item dinova-nav__fade" style="--i: {{ item_index }};">
          {%- if link.links.size > 0 -%}
            <button
              type="button"
              class="dinova-nav__link"
              aria-expanded="false"
              aria-controls="DinovaNavPanel-{{ link.handle }}"
              data-dinova-nav-toggle
              data-dinova-nav-page="DinovaNavPage-{{ link.handle }}"
            >
              <span class="dinova-nav__link-text">{{ link.title | escape }}</span>
              {{- caret -}}
            </button>
          {%- else -%}
            <a
              href="{{ link.url }}"
              class="dinova-nav__link"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              <span class="dinova-nav__link-text">{{ link.title | escape }}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    <div class="dinova-nav__footer">
      {%- if shop.customer_accounts_enabled -%}
        {%- assign item_index = item_index | plus: 1 -%}
        <a
          href="{{ routes.account_url }}"
          class="dinova-nav__account dinova-nav__fade"
          style="--i: {{ item_index }};"
        >
          <span class="dinova-nav__link-text">{% if customer %}My account{% else %}Sign in{% endif %}</span>
        </a>
      {%- endif -%}

      {%- if s.dinova_nav_phone != blank -%}
        {%- assign item_index = item_index | plus: 1 -%}
        {%- assign phone_digits = s.dinova_nav_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
        <a href="tel:{{ phone_digits }}" class="dinova-nav__contact dinova-nav__fade" style="--i: {{ item_index }};">
          <span class="dinova-nav__link-text">{{ s.dinova_nav_phone | escape }}</span>
        </a>
      {%- endif -%}

      {%- if s.dinova_nav_hours != blank -%}
        {%- assign item_index = item_index | plus: 1 -%}
        <p class="dinova-nav__contact dinova-nav__fade" style="--i: {{ item_index }};">{{ s.dinova_nav_hours | escape }}</p>
      {%- endif -%}

      {%- assign platforms = 'facebook,instagram,tiktok,pinterest' | split: ',' -%}
      {%- capture social -%}
        {%- for platform in platforms -%}
          {%- assign key = 'dinova_nav_' | append: platform | append: '_url' -%}
          {%- if s[key] != blank -%}
            <li>
              <a href="{{ s[key] }}" class="dinova-nav__social-link" target="_blank" rel="noopener">
                <span class="visually-hidden">{{ platform | capitalize }}</span>
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                  {%- render 'icon', icon: platform -%}
                </svg>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if social != blank -%}
        {%- assign item_index = item_index | plus: 1 -%}
        <ul class="dinova-nav__social dinova-nav__fade" style="--i: {{ item_index }};" role="list">
          {{- social -}}
        </ul>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Desktop: submenu columns {%- endcomment -%}
  {%- for link in linklist.links -%}
    {%- if link.links.size > 0 -%}
      <div
        class="dinova-nav__panel"
        id="DinovaNavPanel-{{ link.handle }}"
        data-dinova-nav-panel
      >
        <div class="dinova-nav__groups">
          {%- for child in link.links -%}
            <div class="dinova-nav__group dinova-nav__fade" style="--i: {{ forloop.index }};">
              <a href="{{ child.url }}" class="dinova-nav__group-title"{% if child.current %} aria-current="page"{% endif %}>
                <span class="dinova-nav__link-text">{{ child.title | escape }}</span>
              </a>
              {%- if child.links.size > 0 -%}
                <ul class="dinova-nav__group-list" role="list">
                  {%- for grandchild in child.links -%}
                    <li>
                      <a href="{{ grandchild.url }}" class="dinova-nav__small-link"{% if grandchild.current %} aria-current="page"{% endif %}>
                        <span class="dinova-nav__link-text">{{ grandchild.title | escape }}</span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%}
    Desktop: one carousel shared by every submenu, so it keeps playing when another
    item is picked. Images picked in the header settings; without any, the images of
    the collections and products in the menu.
  {%- endcomment -%}
  {%- capture slides -%}
    {%- if picked_images.size > 0 -%}
      {%- for i in picked_images -%}
        {%- assign key = 'dinova_nav_image_' | append: i -%}
        <li class="dinova-nav__slide">
          {{ s[key] | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '24vw', loading: 'lazy', class: 'dinova-nav__image' }}
        </li>
      {%- endfor -%}
    {%- else -%}
      {{- menu_slides -}}
    {%- endif -%}
  {%- endcapture -%}

  {%- if slides != blank -%}
    <div class="dinova-nav__media" aria-hidden="true">
      {%- comment -%} Two copies, so the loop wraps without a gap {%- endcomment -%}
      <ul class="dinova-nav__track" role="list" style="--dinova-nav-speed: {{ s.dinova_nav_image_speed | default: 30 }}s;">
        {{- slides -}}
        {{- slides -}}
      </ul>
    </div>
  {%- endif -%}

  {%- comment -%}
    Mobile: a page per submenu, sliding in from the right. Third-level pages come
    after their parent page, so they stack on top of it.
  {%- endcomment -%}
  {%- for link in linklist.links -%}
    {%- if link.links.size > 0 -%}
      {%- assign page_id = 'DinovaNavPage-' | append: link.handle -%}
      {% render 'dinova-nav-page', page_id: page_id, link: link, caret: caret %}
      {%- for child in link.links -%}
        {%- if child.links.size > 0 -%}
          {%- assign child_page_id = page_id | append: '-' | append: child.handle -%}
          {% render 'dinova-nav-page', page_id: child_page_id, link: child, caret: caret %}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
</dinova-nav>

<script src="{{ 'dinova-nav.js' | asset_url }}" defer></script>

{% stylesheet %}
  /* ---------- The drawer: opens under the header ---------- */

  .menu-drawer:has(> .dinova-nav) {
    --dinova-nav-ease: cubic-bezier(0.22, 1, 0.36, 1);

    top: var(--dinova-nav-top, var(--header-height, 0px));
    height: calc(100dvh - var(--dinova-nav-top, var(--header-height, 0px)));
    width: 100vw;
    max-width: 100vw;
    padding: 0;
    overflow: hidden;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-inline-end: 0;
    transition: transform 0.6s var(--dinova-nav-ease), visibility 0.6s var(--dinova-nav-ease),
      width 0.6s var(--dinova-nav-ease);
  }

  .menu-drawer:has(> .dinova-nav) > :not(.dinova-nav) {
    display: none;
  }

  .dinova-nav {
    flex: 1;
    min-height: 0;
    color: var(--color-foreground);
  }

  .dinova-nav__main {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow-y: auto;
  }

  /* ---------- Links: a line grows under every link on hover ---------- */

  .dinova-nav__link-text {
    background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 0 1px;
    transition: background-size 0.4s var(--dinova-nav-ease);
  }

  :is(a, button):hover > .dinova-nav__link-text,
  [aria-expanded='true'] > .dinova-nav__link-text {
    background-size: 100% 1px;
  }

  /* ---------- Top-level items ---------- */

  .dinova-nav__list,
  .dinova-nav__page-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dinova-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.6rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2.5rem, 3.4vw, 3.5rem);
    line-height: 1.25;
    text-align: start;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .dinova-nav__caret {
    display: inline-flex;
    flex: none;
    width: 0.75rem;
    transform: rotate(-90deg);
    transition: transform 0.3s ease;
  }

  .dinova-nav__caret svg {
    width: 100%;
    height: auto;
  }

  .dinova-nav__link:hover .dinova-nav__caret {
    transform: rotate(-90deg) translateY(0.25rem);
  }

  /* ---------- Footer: account, contact and social ---------- */

  .dinova-nav__footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-block-start: auto;
  }

  .dinova-nav__small-link,
  .dinova-nav__account {
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: none;
  }

  .dinova-nav__contact {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    font-family: var(--font-body--family);
    font-size: 1rem;
    text-decoration: none;
  }

  .dinova-nav__social {
    display: flex;
    gap: 0.75rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .dinova-nav__social-link {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: 50%;
    color: inherit;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .dinova-nav__social-link svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .dinova-nav__social-link:hover {
    border-color: var(--color-foreground);
    background: var(--color-foreground);
    color: var(--color-background);
  }

  /* ---------- Entrance: items fade in from top to bottom ---------- */

  .menu-open .dinova-nav__main .dinova-nav__fade {
    animation: dinova-nav-fade 0.6s var(--dinova-nav-ease) both;
    animation-delay: calc(0.3s + var(--i) * 0.05s);
  }

  /* ========== Mobile and tablet: pages that slide in from the right ========== */

  @media screen and (max-width: 989px) {
    .dinova-nav {
      position: relative;
      overflow: hidden;
    }

    .dinova-nav__main {
      gap: 2.5rem;
      height: 100%;
      padding: 1.25rem 1.5rem 2rem;
    }

    .dinova-nav__panel,
    .dinova-nav__media {
      display: none;
    }

    /* Items with a submenu run the full width, caret on the right */
    .dinova-nav__link {
      width: 100%;
      justify-content: space-between;
      padding: 0.45rem 0;
      font-size: 2.5rem;
    }

    .dinova-nav__page {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      background: var(--color-background);
      transform: translateX(100%);
      visibility: hidden;
      transition: transform 0.5s var(--dinova-nav-ease), visibility 0.5s;
    }

    .dinova-nav__page.is-open {
      transform: none;
      visibility: visible;
    }

    .dinova-nav__page-bar {
      display: grid;
      grid-template-columns: 3.5rem 1fr 3.5rem;
      align-items: center;
      border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    }

    .dinova-nav__back {
      display: grid;
      place-items: center;
      height: 3.5rem;
      border: 0;
      background: none;
      color: inherit;
      cursor: pointer;
    }

    .dinova-nav__back .dinova-nav__caret {
      transform: rotate(90deg);
    }

    .dinova-nav__back:hover .dinova-nav__caret {
      transform: rotate(90deg) translateY(0.2rem);
    }

    .dinova-nav__page-title {
      justify-self: center;
      color: inherit;
      font-family: var(--font-body--family);
      font-size: 0.9375rem;
      text-decoration: none;
    }

    .dinova-nav__page-list {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 1.25rem 1.5rem 2rem;
    }

    .dinova-nav__page .dinova-nav__link {
      font-size: 2rem;
    }

    /* The page slides in blank, then its items fade in one by one */
    .dinova-nav__page.is-open .dinova-nav__fade {
      animation: dinova-nav-fade 0.6s var(--dinova-nav-ease) both;
      animation-delay: calc(0.35s + var(--i) * 0.06s);
    }

    .dinova-nav__page:not(.is-open) .dinova-nav__fade {
      opacity: 0;
    }
  }

  /* Account sits in the header from 750px */
  @media screen and (min-width: 750px) {
    .dinova-nav__account {
      display: none;
    }
  }

  /* ========== Desktop: submenu columns and image carousel ========== */

  @media screen and (min-width: 990px) {
    .menu-drawer:has(> .dinova-nav) {
      width: var(--dinova-nav-main-width, 28rem);
    }

    .menu-drawer:has(> .dinova-nav[data-expanded]) {
      width: 100vw;
    }

    .menu-drawer-container:has(.dinova-nav) .menu-drawer__backdrop {
      top: var(--dinova-nav-top, var(--header-height, 0px));
      height: auto;
      bottom: 0;
      background: rgb(var(--color-background-rgb) / 0.1);
      backdrop-filter: blur(0);
      -webkit-backdrop-filter: blur(0);
      transition: opacity 0.3s ease, backdrop-filter 0.3s ease, -webkit-backdrop-filter 0.3s ease;
    }

    /* The blur builds up as the drawer slides in */
    .menu-open.menu-drawer-container:has(.dinova-nav) .menu-drawer__backdrop {
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition: opacity 0.3s ease 0.1s, backdrop-filter 0.4s ease 0.1s, -webkit-backdrop-filter 0.4s ease 0.1s;
    }

    .dinova-nav {
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr) minmax(0, 24rem);
    }

    /* Sized by its longest item, so menu names stay on one line */
    .dinova-nav__main {
      min-width: 28rem;
      gap: 2.5rem;
      padding: 2.5rem 3rem 2.5rem 4.5rem;
    }

    .dinova-nav__page {
      display: none;
    }

    /* While a submenu is open, the other items step back */
    .dinova-nav[data-expanded] .dinova-nav__link:not([aria-expanded='true']) {
      opacity: 0.45;
    }

    .dinova-nav[data-expanded] .dinova-nav__link:not([aria-expanded='true']):hover {
      opacity: 1;
    }

    /* ---------- Submenu panel ---------- */

    .dinova-nav__panel {
      display: none;
      grid-area: 1 / 2;
      min-height: 0;
    }

    .dinova-nav__panel.is-active {
      display: grid;
    }

    .dinova-nav:not(:has(.dinova-nav__media)) .dinova-nav__panel {
      grid-column: 2 / -1;
    }

    .dinova-nav__groups {
      display: grid;
      grid-template-columns: repeat(var(--dinova-nav-columns), minmax(0, 1fr));
      align-content: start;
      gap: 3rem 2.5rem;
      padding: 2.75rem 2.5rem;
      overflow-y: auto;
    }

    .dinova-nav__group-title {
      display: inline-block;
      color: inherit;
      font-family: var(--font-heading--family);
      font-size: 1.875rem;
      line-height: 1.2;
      text-decoration: none;
    }

    .dinova-nav__group-list {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
      margin: 1.25rem 0 0;
      padding: 0;
      list-style: none;
    }

    .dinova-nav__panel.is-active .dinova-nav__fade {
      animation: dinova-nav-fade 0.6s var(--dinova-nav-ease) both;
      animation-delay: calc(0.15s + var(--i) * 0.05s);
    }

    /* ---------- Image carousel: plays from bottom to top ---------- */

    /* Hidden with opacity rather than display, so the loop never restarts */
    .dinova-nav__media {
      grid-area: 1 / 3;
      position: relative;
      overflow: hidden;
      padding-inline-end: 2.5rem;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s;
    }

    .dinova-nav[data-expanded] .dinova-nav__media {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.8s ease 0.2s, visibility 0s;
    }

    .dinova-nav__track {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin: 0;
      padding: 0;
      list-style: none;
      animation: dinova-nav-rise var(--dinova-nav-speed) linear infinite;
    }

    .dinova-nav__media:hover .dinova-nav__track {
      animation-play-state: paused;
    }

    .dinova-nav__image {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  @keyframes dinova-nav-fade {
    from {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes dinova-nav-rise {
    to {
      transform: translateY(calc(-50% - 0.375rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dinova-nav__track,
    .dinova-nav__fade {
      animation: none !important;
    }

    .dinova-nav__page {
      transition: none;
    }
  }
{% endstylesheet %}
